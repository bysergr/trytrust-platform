# Copy to .env.local and fill in. Everything here is server-side unless it is
# prefixed NEXT_PUBLIC_ — that prefix ships the value to the browser.
#
# In development, anything left blank falls back to an isolated in-memory or
# demo adapter. Production fails closed for auth, persistence and kernel access.

# ── the TryTrust kernel ──────────────────────────────────────────────────────
# uv run uvicorn src.api.main:app --port 8001   (PYTHONPATH=.:src)
KERNEL_API_URL=http://localhost:8001
KERNEL_SERVICE_TOKEN=
DEFAULT_AGENT_ID=agt_flights

# ── local Rappi credential bridge ────────────────────────────────────────────
# Public because the browser connects directly to a bridge on the same machine.
NEXT_PUBLIC_RAPPI_BRIDGE_URL=http://localhost:8010

# ── the voice console at /voice ──────────────────────────────────────────────
# Mints the short-lived realtime client secret in
# app/api/realtime/client-secret/route.ts. Never prefix this NEXT_PUBLIC_.
OPENAI_API_KEY=

# ── accounts ─────────────────────────────────────────────────────────────────
# Without this, development signs everyone in as the demo user.
NEXT_PUBLIC_HANKO_API_URL=

# ── persistence ──────────────────────────────────────────────────────────────
# Apply db/migrations/0001_trytrust_web.sql first. Unset uses the memory store.
DATABASE_URL=

# ── generated artifacts ──────────────────────────────────────────────────────
# GOOGLE_API_KEY is read as a fallback; GEMINI_MODEL overrides the default.
GEMINI_API_KEY=
